
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title>Budget Manager</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header>
		<h1>Budget Manager</h1>
		<nav>
			<button onclick="changeBudget()">Change Budget</button>
			<a href="/addTransaction">
				<button>Add Transaction</button>
			</a>
			<a href="/manageTransactions">
				<button>Manage Transactions</button>
			</a>
			<form  action="/clear" method="get">
				<button type="submit" onclick="return confirm('Are you sure you want to clear all transactions?\nThis cannot be undone')">Clear All Transactions</button>
			</form>
			<form id="logout" action="/logout" method="get">
				<button type="submit">Log Out</button>
			</form>
			<nav id="account">account: <%- username -%></nav>
        </nav>
	</header>

	<div>
		<p id="total-budget"> </p>
	</div>
	<hr>
	<div id="budgetInfo">
		<p>
			All Transactions:<br>
		</p>
			<%- transactionInfo -%>
		
	</div>

	<% if (totalSpent) { %>
		<nav id="pageData">
			<button onclick="createTable()">All Purchases</button>
			<button onclick="createGraph('bar')">Bar Graph</button>
			<button onclick="createGraph('doughnut')">Pie Chart</button>
    	</nav>
	<% } %>
	
	<hr>
	<div>
		<p id="budget-left"> Remaining Budget: </p>
	</div>

	<!-- giving myself credit -->
    <footer>
        <p>Made by samuel940</p>
    </footer>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		window.pageData = {
			totalSpent: Number("<%= totalSpent %>") || 0,
			userBudget: Number("<%= userBudget %>") || 1000,
			allPurchases: <%- JSON.stringify(allPurchases || []) %>
		};
	</script>
	
	<script src="budgeting.js"></script>
	
</body>

</html>
