
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<title>Manage Transactions | Budget Manager</title>
	<link rel="stylesheet" href="/webstyle.css">
</head>

<body>
	<header>
		<h1>Delete Purchases</h1>
		<nav>
			
			<a href="/addTransaction">
				<button>Add Transaction</button>
			</a>
			<form  action="/clear" method="get">
				<button type="submit" onclick="return confirm('Are you sure you want to clear all transactions?\nThis cannot be undone')">Clear All Transactions</button>
			</form>
			<a href="/">
				<button>Home</button>
			</a>
			<nav id="account">account: <%- username -%></nav>
        </nav>
	</header>
	<p>All current transactions:</p><hr> 
	<%- noTransactions -%>

	<% if (!noTransactions) { %>
		
	<div class="deleting">
		<%- deletionRows -%>
	</div>
	<% } %>

	<!-- giving myself credit -->
    <footer>
        <p>Made by samuel940</p>
    </footer>

	<script>
		async function changeAmount(more, id, amount) {
			if (more || amount > 1) {
				const response = await fetch("/updateAmount", {
					method: "POST",
					headers: {
						"Content-Type": "application/json"
					},
					body: JSON.stringify({
						id: id,
						more: more
					})
				});

				if (response.ok) {
					location.reload();
				}
			}
		}

		async function deleteTransaction(id) {
			const response = await fetch("/delete", {
				method: "POST",
				headers: {
					"Content-Type": "application/json"
				},
				body: JSON.stringify({
					id: id
				})
			});

			if (response.ok) {
				location.reload();
			}
		}
	</script>
	
</body>

</html>
